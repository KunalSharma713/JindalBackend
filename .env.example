# MongoDB connection string (replace with your actual link)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority


#Authentication JWT
JWT_SECRET=your_super_secret_access_token_12345
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_67890
REFRESH_TOKEN_EXPIRATION=60d


#SMTP
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_password

#Application
PORT=3000